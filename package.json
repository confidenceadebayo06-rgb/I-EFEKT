{
  "name": "iefekt-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run engine:build && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "engine:build": "node scripts/build-engine.mjs",
    "engine:benchmark": "node scripts/benchmark-engine.mjs",
    "test:security": "node --test tests/security/*.test.mjs",
    "backup:mysql": "node scripts/backup-mysql.mjs",
    "test:backup:restore": "node scripts/restore-backup-smoke.mjs",
    "test:backup:dropbox-live": "node scripts/dropbox-live-smoke.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.1.1",
    "@prisma/client": "^6.5.0",
    "@aws-sdk/client-s3": "^3.800.0",
    "@aws-sdk/s3-request-presigner": "^3.800.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.10.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2",
    "ioredis": "^5.6.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^6.4.17",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
